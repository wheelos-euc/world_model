module(
    name = "wheelos_world_model",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "googletest", version = "1.17.0", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "29.0.bcr.1", repo_name = "com_google_protobuf")
bazel_dep(name = "wheelos_core", version = "1.0.6", repo_name = "core")
bazel_dep(name = "eigen", version = "4.0.0-20241125.bcr.2")
bazel_dep(name = "opencv", version = "4.13.0")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "0.34.0")
bazel_dep(name = "wheelos_common", version = "0.1.3")
bazel_dep(name = "wheelos_msgs", version = "0.1.6")
bazel_dep(name = "wheelos_perception", version = "0.1.0")
bazel_dep(name = "wheelos_map", version = "0.1.1")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "wheelos_transform", version = "0.1.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "/usr/local/cuda",
)
use_repo(cuda, "cuda")

tensorrt = use_extension("@wheelos_common//third_party/tensorrt:extensions.bzl", "tensorrt_configure")
use_repo(tensorrt, "local_config_tensorrt")

single_version_override(
    module_name = "rules_pkg",
    patch_strip = 1,
    patches = ["//third_party/rules_pkg:execroot_runfiles.patch"],
    version = "1.3.0",
)
