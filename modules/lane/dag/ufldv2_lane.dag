module_config {
  module_library : "/apollo/bazel-bin/external/wheelos_world_model+/modules/lane/lane_component_plugin"

  components {
    class_name : "LaneDetectionComponent"
    config {
      name : "ufldv2_lane"
      config_file_path : "/apollo/pkgs/world_model/modules/lane/conf/ufldv2_lane.pb.txt"
      readers {
        channel : "/apollo/sensor/camera/front_6mm/image"
        pending_queue_size : 1
      }
    }
  }
}
